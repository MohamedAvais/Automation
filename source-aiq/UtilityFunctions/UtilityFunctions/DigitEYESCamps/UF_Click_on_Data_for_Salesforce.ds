<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_60_To_Verify_that_camp_cluster_records_are_filtered_correctly_when_multiple_status_checkboxes_are_selected.ds' description= '' author= '' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='click' value='""' type='web' desc='Click on Data for Salesforce' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='link(&quot;Data for Salesforce&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='link(2, _in(div({&apos;id&apos;:&apos;home-collapse&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;manage-camps-patients-salesforce.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;home-collapse&apos;]/ul/li[3]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Data for Salesforce&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li/div/ul/li[3]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;home-collapse&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[3]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;manage-camps-patients-salesforce.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='link(2, _in(div(&quot;home-collapse&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
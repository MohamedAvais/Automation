<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_62_To_verify_that_the_Search_Filter_button_is_displayed_and_functional _on_the_Implementation_Partners_page.ds' description= '' author= 'null' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='setValue' value='"TesterQA"' type='web' desc='Enter partner name to be searched' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='textbox(&quot;search_ipname&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrName' value='textbox(&quot;search_ipname&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//input[@id=&apos;search_ipname&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;search_ipname&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='textbox(&quot;form-control input_width&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;search_ipname&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;form-control input_width&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[2]/div/input&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;search_ipname&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#search_ipname&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;search_ipname&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal-body&quot;] &gt; form[class=&quot;form-horizontal&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-8 paddingtop&quot;] &gt; input[class=&quot;form-control input_width&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
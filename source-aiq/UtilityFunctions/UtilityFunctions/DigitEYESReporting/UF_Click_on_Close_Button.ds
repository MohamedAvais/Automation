<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_07_To_verify_that_clicking_the_Close_button_closes_the_Search_Filter_page.ds' description= '' author= 'null' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='click' value='""' type='web' desc='Click on Close button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Close&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-secondary btn-sm[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[5]/button[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Close&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[5]/button[3]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
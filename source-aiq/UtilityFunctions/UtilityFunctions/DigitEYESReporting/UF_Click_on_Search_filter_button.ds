<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_05_To_verify_that _Close_button_is_functional_on_Search Filter_page.ds' description= '' author= 'null' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='click' value='""' type='web' desc='Click on Search/Filter button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='button(&quot;btnSearch&quot;)' fallback='true' selected='true'/>

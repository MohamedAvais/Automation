<step action='navigateTo' value='"https://dealphacloud.visionspring.org/"' type='web' desc='Navigate to the &quot;https://dealphacloud.visionspring.org/&quot;' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

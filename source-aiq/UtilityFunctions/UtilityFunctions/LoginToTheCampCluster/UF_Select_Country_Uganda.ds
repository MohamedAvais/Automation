<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_30_To_Verify_that_Currency_field_is_automatically_updated_to_BDT_when_Country_is_selected_as_Bangladesh.ds' description= '' author= '' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='click' value='""' type='web' desc='Select Uganda' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='label(&quot;Uganda&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divLoginCountry&apos;]/div/div/div[2]/div/div[1]/div/label[6]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Uganda&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[2]/div/div/div[2]/div/div/div/label[6]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='label({&apos;for&apos;:&apos;btnLoginCountryUGA&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='label(&quot;btn btn-outline-primary fs-2 mb-3 me-3[5]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
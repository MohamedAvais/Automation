<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_62_To_Verify_that_Data_for_Salesforce_page_loads_successfully_without_errors.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on data for salesforce' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_Data_for_Salesforce.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='' fallback='false' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify Status is visible in table header' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;Status&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/thead/tr/th[6]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Status&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/thead/tr/th[6]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/thead[1]/tr[1]/th[6]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='tableHeader({&apos;style&apos;:&apos;text-align:center;&apos;})' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify closed status is visible under status column' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Closed&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15615&apos;]/td[6]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;label label-warning&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Closed&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[3]/td[6]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15615&apos;)/td[6]/span[@class=&apos;label label-warning&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[6]//span[@class=&quot;label label-warning&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[6]//span[text()=&quot;Closed&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='span({&apos;aria-describedby&apos;:&apos;popover488063&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;span[class=&quot;label label-warning&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.label.label-warning&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label label-warning&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
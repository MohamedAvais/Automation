<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_65_To_Verify_that_View_Summary_Report_button_is_visible_for_each_camp_record.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on data for salesforce' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_Data_for_Salesforce.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on View Summary Report button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='submit(&quot;View Summary Report&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[2]/td[1]/button&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-error btn-sm btnViewSummaryReport&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; View Summary Report&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[2]/td/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[@class=&apos;collapse show cid15684&apos;]/td[@class=&apos;text-end&apos;]/button[@class=&apos;btn btn-error btn-sm btnViewSummaryReport&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[1]//button[@class=&quot;btn btn-error btn-sm btnViewSummaryReport&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[1]//button[text()=&quot; View Summary Report&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='submit({&apos;style&apos;:&apos;background:blueviolet;color:white&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;tr[class=&quot;collapse show cid15684&quot;] &gt; td[class=&quot;text-end&quot;] &gt; button[class=&quot;btn btn-error btn-sm btnViewSummaryReport&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.collapse.show.cid15684 &gt; .text-end &gt; .btn.btn-error.btn-sm.btnViewSummaryReport&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;btn btn-error btn-sm btnViewSummaryReport&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify View Summary Report heading is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading4(&quot;View Summary Report&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='heading4(0, _in(div({&apos;id&apos;:&apos;divDetails&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;lblDetailsTitle&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='heading4(&quot;lblDetailsTitle&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//h4[@id=&apos;lblDetailsTitle&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;View Summary Report&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div/div/h4&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;lblDetailsTitle&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='heading4({&apos;style&apos;:&apos;margin:0px&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#lblDetailsTitle&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading4(0, _in(div(&quot;divDetails&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify Vision Access Programs - Daily Outr heading is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='bold([&quot;Vision Access Programs - Daily Outr&quot;])' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divDetailsContent&apos;]/div/div/div[1]/div/table/tbody/tr[1]/td[1]/h4/b&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Vision Access Programs - Daily Outreach Summary Report&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/div/div/div/div/div/table/tbody/tr/td/h4/b&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;divDetailsContent&apos;)/div[@class=&apos;container-fluid main-container&apos;]/div[@class=&apos;col-md-12 content&apos;]/div[@class=&apos;row rowmb18 pdfprint1&apos;]/div[@class=&apos;col-sm-12 form-group&apos;]/table[@class=&apos;display table thintable table-bordered&apos;]/tbody[1]/tr[1]/td[@class=&apos;text-primary&apos;]/h4[1]/b[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[1]//h4//b[text()=&quot;Vision Access Programs - Daily Outreach Summary Report&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
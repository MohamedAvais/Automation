<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_67_To_Verify_that_error_message_when_pushing_GEO_data_to_Salesforce_with_missing_or_inaccessible_External_ID.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on data for salesforce' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_Data_for_Salesforce.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on Push Consent button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='submit(&quot;Push Consent&quot;)' fallback='true' selected='true'/>
   <accessor type='Attribute' value='submit({&apos;onclick&apos;:&quot;location.href=&apos;signatures.php?code=MTU2ODQ=&apos;;&quot;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;btn btn-secondary btn-sm[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[2]/td[2]/button[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-sm btn-secondary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Push Consent&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[2]/td[2]/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[@class=&apos;collapse show cid15684&apos;]/td[2]/button[@class=&apos;btn btn-sm btn-secondary&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[2]//button[@class=&quot;btn btn-sm btn-secondary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[2]//button[text()=&quot; Push Consent&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[class=&quot;btn btn-sm btn-secondary&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify the &quot;Consent on SharePoint Pending&quot; page are visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading3(&quot;Consent on SharePoint Pending&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='heading3(&quot;m-0&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&apos;//header/div[1]/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;m-0&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Consent on SharePoint Pending&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;/html[1]/body[1]/header[@class=&apos;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&apos;]/div[@class=&apos;col-md-3 col-lg-3 ps-1&apos;]/h3[@class=&apos;m-0&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.navbar.navbar-dark.sticky-top.flex-md-nowrap.shadow.p-0.bg-primary &gt; .col-md-3.col-lg-3.ps-1 &gt; .m-0&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;header[class=&quot;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&quot;] &gt; div[class=&quot;col-md-3 col-lg-3 ps-1&quot;] &gt; h3[class=&quot;m-0&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
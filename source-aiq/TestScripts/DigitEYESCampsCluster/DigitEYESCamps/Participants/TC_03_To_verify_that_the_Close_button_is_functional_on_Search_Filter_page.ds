</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Participants from sidebar menu' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_Participants_button.ds"' fallback='true' selected='true'/>

<step action='click' value='""' type='web' desc='Click on close button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Close&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='button(2, _in(form({&apos;id&apos;:&apos;frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-secondary btn-sm[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[3]/button[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Close&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[3]/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='button(2, _in(form(&quot;frmSearch&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>

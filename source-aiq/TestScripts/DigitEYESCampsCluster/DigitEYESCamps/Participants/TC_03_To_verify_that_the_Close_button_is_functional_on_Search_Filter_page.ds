<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_01_To verify_that_user_can_click_on_Participant_button_from_side_bar_menu.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/Vision Spring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>

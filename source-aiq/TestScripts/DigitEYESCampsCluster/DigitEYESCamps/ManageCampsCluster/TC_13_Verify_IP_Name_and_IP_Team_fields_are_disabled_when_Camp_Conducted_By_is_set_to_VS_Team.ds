</dialect>
</step>
<step action='store' value='getAttribute(select(&quot;id==DE_Camp_ipid&quot;),&quot;readonly&quot;)' type='web' desc='Storing value of readonly attr' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

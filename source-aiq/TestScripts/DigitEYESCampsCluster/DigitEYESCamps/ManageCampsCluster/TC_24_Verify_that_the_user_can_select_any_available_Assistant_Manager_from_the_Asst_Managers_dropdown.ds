   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;DE_Camp_asstmanager&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='store' value='getText(select(&quot;DE_Camp_asstmanager&quot;))' type='web' desc='Store value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

</dialect>
</step>
<step action='include' value='' type='web' desc='Click on New camp cluster button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_On_New_Camp_Cluster_Button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India country from dropdown.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Select_Country_India.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='setValue' value='"value"' type='web' desc='Enter value in latitude field.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='textbox(&quot;DE_Camp_latitude&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='textbox(&quot;form-control[7]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;DE_Camp_latitude&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='textbox(&quot;DE_Camp_latitude&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//input[@id=&apos;DE_Camp_latitude&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/form/div/div[7]/fieldset[3]/div[3]/div/input&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;DE_Camp_latitude&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#DE_Camp_latitude&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;DE_Camp_latitude&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;DE_Camp_latitude&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='store' value='getText(textbox(&quot;id==DE_Camp_latitude&quot;))' type='web' desc='Store value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='StoreValueOfLatitude' fallback='true' selected='true'/>
</dialect>
</step>
<step action='log' value='StoreValueOfLatitude' type='web' desc='Log value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='GetValueOfVisionChart' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertContains' value='"value"' type='web' desc='Verify value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='StoreValueOfLatitude' fallback='true' selected='true'/>
   <accessor type='unknown' value='GetValueOfVisionChart' fallback='true' selected='false'/>
   <accessor type='unknown' value='GetValueOfVisionChart' fallback='true' selected='false'/>
   <accessor type='unknown' value='GetValueOfSecondGlassDropdown' fallback='true' selected='false'/>
   <accessor type='unknown' value=' ManageSkuDropdownValues ' fallback='true' selected='false'/>
   <accessor type='unknown' value=' NumericValueOfSchoolId ' fallback='true' selected='false'/>
   <accessor type='unknown' value='NumericValueOfSchoolId=true' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
   <accessor type='JQuery' value='byJQuery(&apos;select[name=&quot;DE_Camp_secondglass&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;DE_Camp_secondglass&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='select(&quot;DE_Camp_secondglass&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='store' value='getSelectTexts(select(&quot;DE_Camp_secondglass&quot;))' type='web' desc='Store value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

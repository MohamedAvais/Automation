   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/form/div/div[7]/fieldset[2]/div[22]/div/select&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;DE_Camp_secondglass&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;col-md-6&quot;] &gt; fieldset[class=&quot;form-group&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-3&quot;] &gt; select[class=&quot;form-select&quot;]&apos;)' fallback='true' selected='false'/>

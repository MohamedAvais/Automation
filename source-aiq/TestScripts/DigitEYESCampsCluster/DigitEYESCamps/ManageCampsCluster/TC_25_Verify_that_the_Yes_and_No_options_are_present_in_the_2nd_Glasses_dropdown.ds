</dialect>
</step>
<step action='setSelected' value='"Yes"' type='web' desc='Click on secondglass dropdown.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='select(&quot;DE_Camp_secondglass&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='select(&quot;form-select[6]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;DE_Camp_secondglass&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='select(&quot;DE_Camp_secondglass&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//select[@id=&apos;DE_Camp_secondglass&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/form/div/div[7]/fieldset[2]/div[22]/div/select&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;DE_Camp_secondglass&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;col-md-6&quot;] &gt; fieldset[class=&quot;form-group&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-3&quot;] &gt; select[class=&quot;form-select&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#DE_Camp_secondglass&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;select[name=&quot;DE_Camp_secondglass&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;DE_Camp_secondglass&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='select(&quot;DE_Camp_secondglass&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='store' value='getSelectTexts(select(&quot;DE_Camp_secondglass&quot;))' type='web' desc='Store value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

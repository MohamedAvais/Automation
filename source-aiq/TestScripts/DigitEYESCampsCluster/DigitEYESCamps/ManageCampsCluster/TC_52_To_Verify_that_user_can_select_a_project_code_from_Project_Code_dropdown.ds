<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_50_To_Verify_that_user_can_select_a_project_code_from_Project_Code_dropdown.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>

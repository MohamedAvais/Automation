<step action='assertContainsText' value='"ADK20XXXXXGLO510XXIA"' type='web' desc='Verify project code is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='select(&quot;search_projectcode&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='select(0, _in(div({&apos;id&apos;:&apos;divsearch_projectcode&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;search_projectcode&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='select(&quot;form-select[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;search_projectcode&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='select(&quot;search_projectcode&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//select[@id=&apos;search_projectcode&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div/div[2]/div[2]/div/select&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;search_projectcode&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#search_projectcode&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;select[name=&quot;search_projectcode&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='select(0, _in(div(&quot;divsearch_projectcode&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
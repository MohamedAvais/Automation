<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_33_To_Verify_that_Currency_field_is_automatically_updated_to_KES_when_Country_is_selected_as_Uganda.ds' description= '' author= '' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select Uganda country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Select_Country_Uganda.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on New camp cluster button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_On_New_Camp_Cluster_Button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select Uganda from dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Select_Uganda_from_dropdown.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='"KES"' type='web' desc='Verify KES currency is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='textbox(&quot;id==DE_Camp_currency&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
</testcase>
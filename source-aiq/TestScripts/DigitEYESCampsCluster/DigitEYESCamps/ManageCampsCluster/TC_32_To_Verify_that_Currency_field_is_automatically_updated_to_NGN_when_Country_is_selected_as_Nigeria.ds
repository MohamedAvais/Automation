<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_32_To_Verify_that_Currency_field_is_automatically_updated_to_NGN_when_Country_is_selected_as_Nigeria.ds' description= '' author= '' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select Nigeria country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Select_Country_Nigeria.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on New camp cluster button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_On_New_Camp_Cluster_Button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select Nigeria from dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Select_Nigeria_from_dropdown.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='"NGN"' type='web' desc='Verify NGN currency is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='textbox(&quot;id==DE_Camp_currency&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
</testcase>
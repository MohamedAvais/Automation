   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;search_asstmanager&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='textbox({&apos;type&apos;:&apos;text&apos;})' fallback='true' selected='false'/>

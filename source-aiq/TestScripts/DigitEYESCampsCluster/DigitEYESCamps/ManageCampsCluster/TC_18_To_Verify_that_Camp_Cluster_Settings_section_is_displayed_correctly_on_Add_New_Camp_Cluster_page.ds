<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_18_To_Verify_that_Camp_Cluster_Settings_section_is_displayed_correctly_on_Add_New_Camp_Cluster_page.ds' description= '' author= '' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on New camp cluster button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_On_New_Camp_Cluster_Button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India country from dropdown.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Select_Country_India.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify Camp Cluster Settings section is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='custom(&quot;legend&quot;, &quot;Camp Cluster Settings:&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;DE_Camp_Form&apos;]/div/div[7]/fieldset[2]/legend&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Camp Cluster Settings:&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/form/div/div[7]/fieldset[2]/legend&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;DE_Camp_Form&apos;)/div[@class=&apos;row py-2&apos;]/div[@class=&apos;col-md-6&apos;]/fieldset[@class=&apos;form-group&apos;]/legend[@class=&apos;bg-secondary&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;row py-2&quot;] &gt; div[class=&quot;col-md-6&quot;] &gt; fieldset[class=&quot;form-group&quot;] &gt; legend[class=&quot;bg-secondary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#DE_Camp_Form &gt; .row.py-2 &gt; .col-md-6 &gt; .form-group &gt; .bg-secondary&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='custom(&quot;legend&quot;, &quot;bg-secondary[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify Mobile No. Prefix field is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='label(&quot;Mobile No. Prefix&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;DE_Camp_Form&apos;]/div/div[7]/fieldset[2]/div[2]/label&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Mobile No. Prefix&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/form/div/div[7]/fieldset[2]/div[2]/label&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;DE_Camp_Form&apos;)/div[@class=&apos;row py-2&apos;]/div[@class=&apos;col-md-6&apos;]/fieldset[@class=&apos;form-group&apos;]/div[@class=&apos;row&apos;]/label[@class=&apos;col-sm-4 padtop7 text-end&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;row py-2&quot;] &gt; div[class=&quot;col-md-6&quot;] &gt; fieldset[class=&quot;form-group&quot;] &gt; div[class=&quot;row&quot;] &gt; label[class=&quot;col-sm-4 padtop7 text-end&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.row.py-2 &gt; .col-md-6 &gt; .form-group &gt; .row &gt; .col-sm-4.padtop7.text-end&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='label(&quot;col-sm-4 padtop7 text-end[6]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify National ID max Length field is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='label(&quot;National ID max Length&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;DE_Camp_Form&apos;]/div/div[7]/fieldset[2]/div[3]/label[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;National ID max Length&quot;]&apos;)' fallback='true' selected='false'/>

<step action='assertExists' value='""' type='web' desc='Verify Revised Adult Screening Protocol checkbox is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='label(&quot;Revised Adult Screening Protocol&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;DE_Camp_Form&apos;]/div/div[7]/fieldset[2]/div[1]/label&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;col-sm-11 padtop7&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Revised Adult Screening Protocol&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/form/div/div[7]/fieldset[2]/div/label&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;DE_Camp_Form&apos;)/div[@class=&apos;row py-2&apos;]/div[@class=&apos;col-md-6&apos;]/fieldset[@class=&apos;form-group&apos;]/div[@class=&apos;row&apos;]/label[@class=&apos;col-sm-11 padtop7&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;row py-2&quot;] &gt; div[class=&quot;col-md-6&quot;] &gt; fieldset[class=&quot;form-group&quot;] &gt; div[class=&quot;row&quot;] &gt; label[class=&quot;col-sm-11 padtop7&quot;]&apos;)' fallback='true' selected='false'/>

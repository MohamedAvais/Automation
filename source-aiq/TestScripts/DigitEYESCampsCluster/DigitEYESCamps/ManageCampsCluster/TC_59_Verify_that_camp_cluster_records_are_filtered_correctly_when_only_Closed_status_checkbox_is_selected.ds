<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_59_Verify_that_camp_cluster_records_are_filtered_correctly_when_only_Closed_status_checkbox_is_selected.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on search filter button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_Search_Filter_button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Uncheck New / Open checkbox' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;New / Open&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(0, _in(form({&apos;id&apos;:&apos;frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label-text&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[2]/div/div/div/label[1]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;New / Open&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[2]/div/div/div/label/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmSearch&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-12&apos;]/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-10&apos;]/label[@class=&apos;toggle&apos;]/span[@class=&apos;label-text&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;col-sm-12&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-10&quot;] &gt; label[class=&quot;toggle&quot;] &gt; span[class=&quot;label-text&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.col-sm-12 &gt; .row &gt; .col-sm-10 &gt; .toggle &gt; .label-text&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(0, _in(form(&quot;frmSearch&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Uncheck Running check box' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Running&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(1, _in(form({&apos;id&apos;:&apos;frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label-text[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[2]/div/div/div/label[2]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Running&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[2]/div/div/div/label[2]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(1, _in(form(&quot;frmSearch&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Check closed checkbox' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Closed&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(2, _in(form({&apos;id&apos;:&apos;frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label-text[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[2]/div/div/div/label[3]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Closed&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[2]/div/div/div/label[3]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(2, _in(form(&quot;frmSearch&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on apply button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_apply_button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify data with Closed status is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Closed&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[1]/td[5]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;label label-default&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Closed&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/td[5]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[1]/td[5]/span[@class=&apos;label label-default&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[5]//span[@class=&quot;label label-default&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[5]//span[text()=&quot;Closed&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='span({&apos;data-placement&apos;:&apos;left&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;span[class=&quot;label label-default&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.label.label-default&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label label-default&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertContainsText' value='""' type='web' desc='Verify data with Closed status is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Closed&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[1]/td[5]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;label label-default&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Closed&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/td[5]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[1]/td[5]/span[@class=&apos;label label-default&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[5]//span[@class=&quot;label label-default&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[5]//span[text()=&quot;Closed&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='span({&apos;data-placement&apos;:&apos;left&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;span[class=&quot;label label-default&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.label.label-default&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label label-default&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
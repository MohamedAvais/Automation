<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_01_To_Verify_That_Add_New_Camp_Cluster_Popup_Should_Be_Displayed_By_Clicking_on_New_Camp_Button.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Navigate to URL' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India from country dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on new camp cluster button.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_On_New_Camp_Cluster_Button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify Add New Camp Cluster heading is visible.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading4(&quot;Add New Camp Cluster&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='heading4(0, _in(div({&apos;id&apos;:&apos;divDetails&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;lblDetailsTitle&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='heading4(&quot;lblDetailsTitle&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//h4[@id=&apos;lblDetailsTitle&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Add New Camp Cluster&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div/div/h4&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;lblDetailsTitle&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='heading4({&apos;style&apos;:&apos;margin:0px&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#lblDetailsTitle&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading4(0, _in(div(&quot;divDetails&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
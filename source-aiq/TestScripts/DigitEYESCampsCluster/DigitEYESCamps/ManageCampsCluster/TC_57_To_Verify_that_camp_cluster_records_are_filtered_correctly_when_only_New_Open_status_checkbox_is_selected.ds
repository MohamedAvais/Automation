<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_57_To_Verify_that_camp_cluster_records_are_filtered_correctly_when_only_New_Open_status_checkbox_is_selected.ds' description= '' author= '' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on search filter button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_Search_Filter_button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Uncheck running chechbox' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrValue' value='checkbox(&quot;Run&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[2]/div/div/div/label[2]/input&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[2]/div/div/div/label[2]/input&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;Run&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='checkbox(&quot;search_status[][1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on apply button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_on_apply_button.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='' fallback='false' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify data with new status is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;New[8]&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[9]/td[5]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[9]/td[5]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[9]/td[5]/span[@class=&apos;label label-success&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[9]//td[5]//span[@class=&quot;label label-success&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[9]//td[5]//span[text()=&quot;New&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;label label-success[8]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
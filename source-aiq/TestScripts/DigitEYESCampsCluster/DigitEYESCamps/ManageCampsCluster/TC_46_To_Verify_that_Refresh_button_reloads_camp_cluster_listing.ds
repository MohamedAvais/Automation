<step action='click' value='""' type='web' desc='Click on refresh button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='submit(&quot;Refresh&quot;)' fallback='true' selected='true'/>

<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_17_To_Verify_that_Reader_Rx_and_Popin_checkboxes_are_enabled_when_Camp_Type_is_set_to_Contribution.ds' description= '' author= '' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on New camp cluster button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Click_On_New_Camp_Cluster_Button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India country from dropdown.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Select_Country_India.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select contribution from camp type dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESCamps/UF_Select_Contribution_from_camp_type_dropdown.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='' fallback='false' selected='false'/>
</dialect>
</step>
<step action='store' value='getProp(checkbox(&quot;DE_Camp_contrird&quot;),&quot;disabled&quot;)' type='web' desc='Store Reader checkbox Attribute Value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='Reader_Checkbox_Attr' fallback='true' selected='true'/>
</dialect>
</step>
<step action='log' value='Reader_Checkbox_Attr' type='web' desc='log Reader Attribute Value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='' fallback='false' selected='true'/>
</dialect>
</step>
<step action='assertEqual' value='"false"' type='web' desc='Verify That Reader checkbox is disabled' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='Reader_Checkbox_Attr' fallback='true' selected='true'/>
   <accessor type='unknown' value=' Reader_Checkbox_Attr ' fallback='true' selected='false'/>
   <accessor type='unknown' value=' Reader_Checkbox_Attr ' fallback='true' selected='false'/>
</dialect>
</step>
<step action='store' value='getProp(checkbox(&quot;DE_Camp_contrirx&quot;),&quot;disabled&quot;)' type='web' desc='Store Rx checkbox Attribute Value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='Rx_Checkbox_Attr' fallback='true' selected='true'/>
</dialect>
</step>
<step action='log' value='Rx_Checkbox_Attr' type='web' desc='log Rx Attribute Value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='' fallback='false' selected='true'/>
</dialect>
</step>
<step action='assertEqual' value='"false"' type='web' desc='Verify That Rx checkbox is disabled ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='Rx_Checkbox_Attr' fallback='true' selected='true'/>
   <accessor type='unknown' value=' Reader_Checkbox_Attr ' fallback='true' selected='false'/>
   <accessor type='unknown' value=' Reader_Checkbox_Attr ' fallback='true' selected='false'/>
</dialect>
</step>
<step action='store' value='getProp(checkbox(&quot;DE_Camp_contripi&quot;),&quot;disabled&quot;)' type='web' desc='Store Popin checkbox Attribute Value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='Popin_Checkbox_Attr' fallback='true' selected='true'/>
</dialect>
</step>
<step action='log' value='Popin_Checkbox_Attr' type='web' desc='log Popin Attribute Value' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='' fallback='false' selected='true'/>
</dialect>
</step>
<step action='assertEqual' value='"false"' type='web' desc='Verify That Popin checkbox is disabled ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='Popin_Checkbox_Attr' fallback='true' selected='true'/>
   <accessor type='unknown' value=' Reader_Checkbox_Attr ' fallback='true' selected='false'/>
   <accessor type='unknown' value=' Reader_Checkbox_Attr ' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
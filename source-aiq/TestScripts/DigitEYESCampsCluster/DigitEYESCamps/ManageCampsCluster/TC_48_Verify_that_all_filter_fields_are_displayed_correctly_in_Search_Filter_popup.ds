<step action='assertExists' value='""' type='web' desc='Verify country label is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='label(&quot;Country&quot;)' fallback='true' selected='true'/>

</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify Refresh button is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='submit(&quot;Refresh&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&apos;//header/div[2]/form/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Refresh&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div[2]/form/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='submit({&apos;type&apos;:&apos;submit&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;btn btn-info btn-sm&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
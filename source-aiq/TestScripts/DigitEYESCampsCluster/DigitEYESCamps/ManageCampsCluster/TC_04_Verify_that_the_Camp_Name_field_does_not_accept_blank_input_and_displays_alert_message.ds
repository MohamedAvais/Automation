   <accessor type='JQuery' value='byJQuery(&apos;select[name=&quot;DE_Camp_projectcode&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='select(0, _in(div(&quot;divDE_Camp_projectcode&quot;)))' fallback='true' selected='false'/>

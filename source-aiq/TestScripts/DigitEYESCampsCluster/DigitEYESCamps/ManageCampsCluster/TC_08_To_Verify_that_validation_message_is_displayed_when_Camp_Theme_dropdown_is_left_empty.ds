<step action='assertEqual' value='"true"' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='RequiredPropertyOfCampThemeName' fallback='true' selected='true'/>

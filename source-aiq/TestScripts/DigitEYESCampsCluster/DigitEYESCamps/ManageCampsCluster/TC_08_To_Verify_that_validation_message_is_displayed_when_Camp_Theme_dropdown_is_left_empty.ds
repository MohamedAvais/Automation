</dialect>
</step>
<step action='store' value='getProp(select(&quot;DE_Camp_camptheme&quot;), &apos;required&apos;)' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

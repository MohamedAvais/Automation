   <accessor type='unknown' value='RequiredPropertyOfProjectName' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertTrue' value='RequiredPropertyOfCampThemeName=true' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

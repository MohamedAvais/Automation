<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_14_To_Verify_that_selecting_Pending_in_the_Data_Imported_to_Salesforce_checkboxes_and_clicking_Apply_displays_only_pending_data.ds' description= '' author= 'null' version= ''>

<step action='click' value='""' type='web' desc='Click on apply button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Apply&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[4]/button[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[4]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmSearch&apos;)/div[@class=&apos;modal-footer&apos;]/button[@class=&apos;btn btn-sm btn-primary&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;onclick&apos;:&apos;SearchData(1);&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal-content&quot;] &gt; div[class=&quot;modal-body&quot;] &gt; form[class=&quot;form-horizontal&quot;] &gt; div[class=&quot;modal-footer&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#frmSearch &gt; .modal-footer &gt; .btn.btn-sm.btn-primary&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that pending records is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Pending.Click to sync&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15400&apos;]/td[12]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;badge badge-danger cursor-pointer&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[2]/td[12]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15400&apos;)/td[12]/span[@class=&apos;badge badge-danger cursor-pointer&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[12]//span[@class=&quot;badge badge-danger cursor-pointer&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='span({&apos;onclick&apos;:&quot;location.href=&apos;signatures.php?code=MTU0MDA=&apos;;&quot;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;span[class=&quot;badge badge-danger cursor-pointer&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.badge.badge-danger.cursor-pointer&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='span(&quot;badge badge-danger cursor-pointer&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
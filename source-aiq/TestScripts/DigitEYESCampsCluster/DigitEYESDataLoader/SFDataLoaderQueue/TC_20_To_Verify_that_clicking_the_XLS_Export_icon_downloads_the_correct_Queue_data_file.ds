<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_41_To_Verify_that_clicking_the_XLS_Export_icon_downloads_the_correct_Queue_data_file.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to the camp cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on India Country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on digitEYES Data Loader' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on SF Data Loader Queue' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click on SF_Data_Loader_Queue.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click on SF_Data_Loader_Queue.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on XLS Icon button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='italic(&quot;fa fa-file-excel-o&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15427&apos;]/td[10]/button[2]/i&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;fa fa-file-excel-o&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/td[10]/button[2]/i&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15427&apos;)/td[10]/button[@class=&apos;btn btn-success btn-sm btnDownloadXLS&apos;]/i[@class=&apos;fa fa-file-excel-o&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[10]//button//i[@class=&quot;fa fa-file-excel-o&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[class=&quot;btn btn-success btn-sm btnDownloadXLS&quot;] &gt; i[class=&quot;fa fa-file-excel-o&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.btn.btn-success.btn-sm.btnDownloadXLS &gt; .fa.fa-file-excel-o&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='italic(0, _in(submit({&apos;aria-label&apos;:&apos;XLS Download&apos;})))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
<step action='assertExists' value='""' type='web' desc='Verify that camp status is closed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='cell(&quot;Closed&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15427&apos;]/td[6]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/td[6]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15427&apos;)/td[6]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='cell({&apos;style&apos;:&apos;text-align: center&apos;})' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that camp status is closed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

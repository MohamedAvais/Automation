<step action='assertExists' value='""' type='web' desc='Verify that  Salesforce ID are displayed as Missing' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='span(&quot;badge badge-danger&quot;)' fallback='true' selected='true'/>
   <accessor type='Text' value='span(&quot;Missing&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15400&apos;]/td[11]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;badge badge-danger&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Missing&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[2]/td[11]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15400&apos;)/td[11]/span[@class=&apos;badge badge-danger&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[11]//span[@class=&quot;badge badge-danger&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[2]//td[11]//span[text()=&quot;Missing&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;span[class=&quot;badge badge-danger&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.badge.badge-danger&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that  Salesforce ID are displayed as Missing' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>

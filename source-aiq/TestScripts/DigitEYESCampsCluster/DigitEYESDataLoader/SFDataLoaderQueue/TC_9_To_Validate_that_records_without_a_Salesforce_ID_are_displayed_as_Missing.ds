   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[11]//span[@class=&quot;badge badge-danger&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[11]//span[text()=&quot;Missing&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>

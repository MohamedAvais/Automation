<step action='assertExists' value='""' type='web' desc='Verify that Screened column displays only numeric values' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='cell(&quot;53&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15427&apos;]/td[9]&quot;)' fallback='true' selected='false'/>

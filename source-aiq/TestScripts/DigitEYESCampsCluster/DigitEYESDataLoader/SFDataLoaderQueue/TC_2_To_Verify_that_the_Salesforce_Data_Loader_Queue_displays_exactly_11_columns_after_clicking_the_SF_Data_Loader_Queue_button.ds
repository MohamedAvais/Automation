<step action='assertExists' value='""' type='web' desc='Verify that Ref Column is visible' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;Ref#&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/thead/tr/th[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Ref#&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/thead/tr/th&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/thead[1]/tr[1]/th[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='tableHeader({&apos;nowrap&apos;:&apos;nowrap&apos;})' fallback='true' selected='false'/>
</dialect>
</step>

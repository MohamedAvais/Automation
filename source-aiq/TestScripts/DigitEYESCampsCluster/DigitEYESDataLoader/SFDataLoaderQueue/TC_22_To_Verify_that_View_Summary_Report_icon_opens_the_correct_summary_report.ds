</dialect>
</step>
<step action='include' value='' type='web' desc='Click on SF Data Loader Queue' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click on SF_Data_Loader_Queue.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click on SF_Data_Loader_Queue.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on View Summary button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='submit(&quot;btn btn-error btn-sm btnViewSummaryReport[4]&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15367&apos;]/td[10]/button[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[5]/td[10]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15367&apos;)/td[10]/button[@class=&apos;btn btn-error btn-sm btnViewSummaryReport&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[5]//td[10]//button[@class=&quot;btn btn-error btn-sm btnViewSummaryReport&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='submit({&apos;aria-describedby&apos;:&apos;tooltip185425&apos;})' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that Vision Access Programs - Daily Outreach Summary Report is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='cell(&quot;text-primary&quot;)' fallback='true' selected='true'/>
   <accessor type='unknown' value='cell([&quot;Vision Access Programs - Daily Outr&quot;])' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divDetailsContent&apos;]/div/div/div[1]/div/table/tbody/tr[1]/td[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;text-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div[2]/div/div/div/div/table/tbody/tr/td&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;divDetailsContent&apos;)/div[@class=&apos;container-fluid main-container&apos;]/div[@class=&apos;col-md-12 content&apos;]/div[@class=&apos;row rowmb18 pdfprint1&apos;]/div[@class=&apos;col-sm-12 form-group&apos;]/table[@class=&apos;display table thintable table-bordered&apos;]/tbody[1]/tr[1]/td[@class=&apos;text-primary&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[1][@class=&quot;text-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='cell({&apos;colspan&apos;:&apos;4&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;td[class=&quot;text-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.text-primary&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
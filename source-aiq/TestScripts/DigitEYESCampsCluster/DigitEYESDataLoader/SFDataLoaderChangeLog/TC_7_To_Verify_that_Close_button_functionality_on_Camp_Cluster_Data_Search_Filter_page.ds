<step action='click' value='""' type='web' desc='Click on Close button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Close&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[4]/button[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Close&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[4]/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-secondary btn-sm[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that Salesforce Data Loader - Change Log is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='heading3([&quot;Salesforce Data Loader - Change Log&quot;])' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&apos;//header/div[1]/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;m-0&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Salesforce Data Loader - Change Log&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;/html[1]/body[1]/header[@class=&apos;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&apos;]/div[@class=&apos;col-md-3 col-lg-3 ps-1&apos;]/h3[@class=&apos;m-0&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;body[class=&quot;&quot;] &gt; header[class=&quot;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&quot;] &gt; div[class=&quot;col-md-3 col-lg-3 ps-1&quot;] &gt; h3[class=&quot;m-0&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='heading3(&quot;m-0&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
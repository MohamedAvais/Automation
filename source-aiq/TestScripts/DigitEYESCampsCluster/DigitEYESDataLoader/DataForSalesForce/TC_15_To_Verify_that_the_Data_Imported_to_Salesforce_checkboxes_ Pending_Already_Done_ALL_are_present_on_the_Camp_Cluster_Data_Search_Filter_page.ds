<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_15_To_Verify_that_the_Data_Imported_to_Salesforce_checkboxes_ Pending_Already_Done_ALL_are_present_on_the_Camp_Cluster_Data_Search_Filter_page.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to the Camp Cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on India Country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on DigitEYES Data Loader button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Salesforce button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Data_for_Salesforce_button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Search filter button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Search_Filter_Button.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Search_Button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that All Ready Done  checkbox is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrValue' value='radio(&quot;Marked&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrName' value='radio(&quot;search_downloaded[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[3]/div[2]/label/input&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[3]/div[2]/label/input&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;Marked&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='radio(&quot;form-control1[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that pending and All Ready Done checkbox is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrValue' value='radio(&quot;All&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrName' value='radio(&quot;search_downloaded[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[3]/div[3]/label/input&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[3]/div[3]/label/input&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;All&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='radio(&quot;form-control1[2]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that pending Checkbox is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrValue' value='radio(&quot;Pending&quot;)' fallback='true' selected='true'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;search_downloaded&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='radio(&quot;search_downloaded&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[3]/div[1]/label/input&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;form-control1&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[3]/div/label/input&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmSearch&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-12&apos;]/label[@class=&apos;col-sm-12 text-left&apos;]/input[@class=&apos;form-control1&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='radio({&apos;type&apos;:&apos;radio&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;form[class=&quot;form-horizontal&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-12&quot;] &gt; label[class=&quot;col-sm-12 text-left&quot;] &gt; input[class=&quot;form-control1&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#frmSearch &gt; .row &gt; .col-sm-12 &gt; .col-sm-12.text-left &gt; .form-control1&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;search_downloaded&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;Pending&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='radio(&quot;form-control1&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
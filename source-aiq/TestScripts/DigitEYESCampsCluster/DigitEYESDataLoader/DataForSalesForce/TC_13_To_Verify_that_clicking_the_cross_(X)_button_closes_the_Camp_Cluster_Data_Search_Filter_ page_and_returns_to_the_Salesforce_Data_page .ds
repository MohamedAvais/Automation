<testcase   name= 'TC_13_To_Verify_that_clicking_the_cross_(X)_button_closes_the_Camp_Cluster_Data_Search_Filter_ page_and_returns_to_the_Salesforce_Data_page .ds' description= '' author= 'null' version= ''>

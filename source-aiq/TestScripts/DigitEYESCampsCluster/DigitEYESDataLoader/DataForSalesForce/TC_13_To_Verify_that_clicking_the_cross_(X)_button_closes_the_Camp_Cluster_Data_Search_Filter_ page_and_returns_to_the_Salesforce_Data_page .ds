<step action='click' value='""' type='web' desc='Click onClose button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='button(&quot;btn-close&quot;)' fallback='true' selected='true'/>

   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;Modal_frmSearch&apos;]/div/div/div[1]/button&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn-close&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;Modal_frmSearch&apos;)/div[@class=&apos;modal-dialog&apos;]/div[@class=&apos;modal-content&apos;]/div[@class=&apos;modal-header&apos;]/button[@class=&apos;btn-close&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal fade show&quot;] &gt; div[class=&quot;modal-dialog&quot;] &gt; div[class=&quot;modal-content&quot;] &gt; div[class=&quot;modal-header&quot;] &gt; button[class=&quot;btn-close&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#Modal_frmSearch &gt; .modal-dialog &gt; .modal-content &gt; .modal-header &gt; .btn-close&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='button(0, _in(div(&quot;Modal_frmSearch&quot;)))' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;aria-label&apos;:&apos;Close&apos;})' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_12_To_Verify_that_clicking_the_Search_Filter_opens_the_Camp_Cluster_Data_Search_Filter_page.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to the camp cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on India Country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on digitEYES Data Loader' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on SF Data Loader Change Log' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Data_for_Salesforce_button.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Data_for_Salesforce_button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Search Filter button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Search_Filter_Button.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Search_Filter_Button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that Click on Search Filter button page is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading4(&quot;Camp Cluster Data Search / Filter&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='heading4(0, _in(div({&apos;id&apos;:&apos;Modal_frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;myModalLabel&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='heading4(&quot;modal-title&quot;)' fallback='true' selected='false'/>
   <accessor type='Id' value='heading4(&quot;myModalLabel&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//h4[@id=&apos;myModalLabel&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;modal-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Camp Cluster Data Search / Filter&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div/h4&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;myModalLabel&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='heading4({&apos;align&apos;:&apos;left&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal fade show&quot;] &gt; div[class=&quot;modal-dialog&quot;] &gt; div[class=&quot;modal-content&quot;] &gt; div[class=&quot;modal-header&quot;] &gt; h4[class=&quot;modal-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#myModalLabel&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading4(0, _in(div(&quot;Modal_frmSearch&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
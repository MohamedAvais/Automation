<step action='assertExists' value='""' type='web' desc='Verify Status Result is closed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Closed&quot;)' fallback='true' selected='true'/>

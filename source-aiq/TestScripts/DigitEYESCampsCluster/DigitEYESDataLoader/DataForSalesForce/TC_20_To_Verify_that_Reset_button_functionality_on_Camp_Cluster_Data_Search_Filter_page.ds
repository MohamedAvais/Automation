<step action='setValue' value='"Dehli"' type='web' desc='Enter text in Location field' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='textbox(&quot;form-control&quot;)' fallback='true' selected='true'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;search_location&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrName' value='textbox(&quot;search_location&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[1]/div[2]/div/div/input&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;form-control&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div/div[2]/div/div/input&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmSearch&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-6&apos;]/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-7&apos;]/input[@class=&apos;form-control&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='textbox({&apos;type&apos;:&apos;text&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-6&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-7&quot;] &gt; input[class=&quot;form-control&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.row &gt; .col-sm-6 &gt; .row &gt; .col-sm-7 &gt; .form-control&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;search_location&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on reset button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='reset(&quot;Reset&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[4]/button[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Reset&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[4]/button[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmSearch&apos;)/div[@class=&apos;modal-footer&apos;]/button[@class=&apos;btn btn-sm btn-secondary&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='reset({&apos;type&apos;:&apos;Reset&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal-content&quot;] &gt; div[class=&quot;modal-body&quot;] &gt; form[class=&quot;form-horizontal&quot;] &gt; div[class=&quot;modal-footer&quot;] &gt; button[class=&quot;btn btn-sm btn-secondary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#frmSearch &gt; .modal-footer &gt; .btn.btn-sm.btn-secondary&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='reset(&quot;btn btn-secondary btn-sm&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
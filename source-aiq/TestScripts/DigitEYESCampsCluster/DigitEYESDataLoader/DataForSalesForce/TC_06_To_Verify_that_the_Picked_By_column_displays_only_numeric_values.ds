<step action='assertExists' value='""' type='web' desc='Verify that the Picket by Columns only shows numeric values' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='cell(&quot;1234567890&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15369&apos;]/td[7]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;1234567890&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/td[7]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15369&apos;)/td[7]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[7][text()=&quot;1234567890&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;td[title=&quot;it.helpdesk.india.1@visionspring.org&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrTitle' value='cell(&quot;it.helpdesk.india.1@visionspring.org&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that the Picket by Columns only shows numeric values' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='cell(&quot;1111111111&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15367&apos;]/td[7]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;1111111111&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[3]/td[7]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15367&apos;)/td[7]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[7][text()=&quot;1111111111&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;td[title=&quot;mammoth2@visionspring.org&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrTitle' value='cell(&quot;mammoth2@visionspring.org&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
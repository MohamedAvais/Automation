<step action='click' value='""' type='web' desc='Click on Show Dates button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='submit(&quot;Show Dates[1]&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//tr[@id=&apos;cid15367&apos;]/td[10]/button&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[3]/td[10]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;cid15367&apos;)/td[10]/button[@class=&apos;btn btn-secondary btn-sm&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[10]//button[@class=&quot;btn btn-secondary btn-sm&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[3]//td[10]//button[text()=&quot; Show Dates&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;btn btn-secondary btn-sm[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that Data is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='cell(&quot;2026-02-19        XLS  CSV&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[2]/td[5]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[2]/td[5]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[@class=&apos;collapse show cid15427&apos;]/td[5]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_48_To_Verify_that_clicking_the_Edit_icon_opens_the_selected_error_record_in_edit_mode.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to the camp cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on India Country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on digitEYES Data Loader' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Salesforce Data Loader - Error Cases page' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_SF_Data_Loader_Error_Case.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_On_SF_Data_Loader_Error_Case.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on Edit Icon button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='italic(&quot;fa fa-edit&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[1]/th[1]/a/i&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;fa fa-edit&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/th/a/i&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[1]/th[1]/a[1]/i[@class=&apos;fa fa-edit&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;i[class=&quot;fa fa-edit&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.fa.fa-edit&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='heading1(&quot;modal-title&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='heading1(0, _in(div({&apos;id&apos;:&apos;divEditDataForSalesforce&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divEditDataForSalesforce&apos;]/div/div/div[1]/h1&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[3]/div/div/div/h1&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;divEditDataForSalesforce&apos;)/div[@class=&apos;modal-dialog modal-fullscreen&apos;]/div[@class=&apos;modal-content text-start&apos;]/div[@class=&apos;modal-header&apos;]/h1[@class=&apos;modal-title&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='heading1({&apos;align&apos;:&apos;left&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal fade show&quot;] &gt; div[class=&quot;modal-dialog modal-fullscreen&quot;] &gt; div[class=&quot;modal-content text-start&quot;] &gt; div[class=&quot;modal-header&quot;] &gt; h1[class=&quot;modal-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#divEditDataForSalesforce &gt; .modal-dialog.modal-fullscreen &gt; .modal-content.text-start &gt; .modal-header &gt; .modal-title&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading1(0, _in(div(&quot;divEditDataForSalesforce&quot;)))' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/thead[1]/tr[1]/th[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='tableHeader({&apos;nowrap&apos;:&apos;nowrap&apos;})' fallback='true' selected='false'/>
</dialect>
</step>

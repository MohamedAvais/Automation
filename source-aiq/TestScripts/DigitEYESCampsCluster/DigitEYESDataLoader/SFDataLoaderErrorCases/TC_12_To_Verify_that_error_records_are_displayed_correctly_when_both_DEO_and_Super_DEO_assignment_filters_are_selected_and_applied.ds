<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_56_To_Verify_that_error_records_are_displayed_correctly_when_both_DEO_and_Super_DEO_assignment_filters_are_selected_and_applied.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to the camp cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on India Country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on digitEYES Data Loader' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_on_DigitEYES_Data_Loader.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Salesforce Data Loader - Error Cases page' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_SF_Data_Loader_Error_Case.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_On_SF_Data_Loader_Error_Case.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on search button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Search_Filter_Button.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VS Repo/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESDataLoader/UF_Click_On_Search_Filter_Button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='DEO Checkbox is checked' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrName' value='checkbox(&quot;search_assignment[]&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrValue' value='checkbox(&quot;2&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[2]/div[1]/div[3]/div[1]/input&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[2]/div/div[3]/div/input&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmSearch&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-6&apos;]/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-1&apos;]/input[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='checkbox({&apos;type&apos;:&apos;checkbox&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;search_assignment[]&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;2&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;search_assignment[]&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Super DEO Checkbox is checked' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Parent' value='button(0, _in(form(&quot;frmSearch&quot;)))' fallback='true' selected='true'/>
   <accessor type='Parent' value='button(0, _in(form({&apos;id&apos;:&apos;frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-primary btn-sm&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;Apply&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmSearch&apos;]/div[3]/button[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div[3]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmSearch&apos;)/div[@class=&apos;modal-footer&apos;]/button[@class=&apos;btn btn-sm btn-primary&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;onclick&apos;:&apos;SearchData(1);&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal-content&quot;] &gt; div[class=&quot;modal-body&quot;] &gt; form[class=&quot;form-horizontal&quot;] &gt; div[class=&quot;modal-footer&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#frmSearch &gt; .modal-footer &gt; .btn.btn-sm.btn-primary&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Verify that Super DEO data is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Super DEO&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[1]/td[9]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Super DEO&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/td[9]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[1]/td[9]/span[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Verify that DEO data is displayed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;DEO&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[4]/td[9]/span&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;DEO&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr[4]/td[9]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[4]/td[9]/span[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
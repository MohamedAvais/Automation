<step action='click' value='""' type='web' desc='Click on Retry Icon button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='italic(&quot;cursor-pointer fa fa-upload&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[1]/th[2]/a/i&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;fa fa-upload cursor-pointer&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/th[2]/a/i&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[1]/th[2]/a[1]/i[@class=&apos;fa fa-upload cursor-pointer&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;i[class=&quot;fa fa-upload cursor-pointer&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.fa.fa-upload.cursor-pointer&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
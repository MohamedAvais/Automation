<step action='assertExists' value='""' type='web' desc='Click on Participant Consents' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading3(&quot;Consent on SharePoint Pending&quot;)' fallback='true' selected='true'/>

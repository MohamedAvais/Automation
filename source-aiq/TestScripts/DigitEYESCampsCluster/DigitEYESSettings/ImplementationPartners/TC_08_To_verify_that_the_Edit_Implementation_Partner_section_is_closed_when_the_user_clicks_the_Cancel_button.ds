<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_67_To_verify_that_the_Edit_Implementation_Partner_section_is_closed_when_the_user_clicks_the_Cancel_button.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>

<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_15_To_verify_that_clicking_the_Close_button_on_the_Define_Hospital_page_navigates_the_user_back_to_the_Hospitals_page.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster App with valid credentials' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='select country and proceed with office button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the DigitEYESSetting Module' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the Hospital modules link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_click_on_the_Hospitals_link.ds"' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[4]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;hospitals.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Hospitals&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[3]/div/ul/li[3]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;digiteyes-settings&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[3]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;hospitals.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;digiteyes-settings&apos;]/ul/li[3]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Hospitals&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the Add New hospital button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_Click_On_The_Add_New_Hospital_Button.ds"' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnAdd&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;New Hospital&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-sm btn-info&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnAdd&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-info btn-sm&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; New Hospital&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div[2]/form/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnAdd&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;type&apos;:&apos;button&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnAdd&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;header[class=&quot;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&quot;] &gt; div[class=&quot;col-md-5 col-lg-5 text-center&quot;] &gt; form[class=&quot;form-inline&quot;] &gt; button[class=&quot;btn btn-sm btn-info&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='button(&quot;btnAdd&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESSettings/UF_Click_On_The_Add_New_Hospital_Button.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='verified that on clicking on the close button on right top, pop-up is closed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;× Close&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='span(0, _in(div(&quot;divPopup&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='span(0, _in(div({&apos;id&apos;:&apos;divPopup&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;× Close&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div/div/div/button/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;divPopup&apos;)/div[@class=&apos;modal-dialog modal-fullscreen&apos;]/div[@class=&apos;modal-content text-start&apos;]/div[@class=&apos;modal-header&apos;]/button[@class=&apos;btn btn-xs btn-outline-secondary pull-right py-1&apos;]/span[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='span({&apos;aria-hidden&apos;:&apos;true&apos;})' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;divPopup&apos;]/div/div/div[1]/button/span&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the Add New hospital button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_Click_On_The_Add_New_Hospital_Button.ds"' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnAdd&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;New Hospital&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-sm btn-info&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnAdd&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-info btn-sm&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; New Hospital&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div[2]/form/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnAdd&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;type&apos;:&apos;button&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnAdd&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;body[class=&quot;&quot;] &gt; header[class=&quot;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&quot;] &gt; div[class=&quot;col-md-5 col-lg-5 text-center&quot;] &gt; form[class=&quot;form-inline&quot;] &gt; button[class=&quot;btn btn-sm btn-info&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='button(&quot;btnAdd&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='verified that on clicking on the close button on the right side of save button, pop-up is closed' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='span(&quot;Close&quot;)' fallback='true' selected='true'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div/div/div[2]/div/div/div[2]/form/div[7]/div[2]/button[2]/span&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmAddData&apos;)/div[@class=&apos;row pt-3&apos;]/div[@class=&apos;col-sm-7 text-end&apos;]/button[@class=&apos;btn btn-sm btn-outline-secondary&apos;]/span[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmAddData&apos;]/div[7]/div[2]/button[2]/span&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
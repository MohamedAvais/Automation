<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_02_To_verify_Next_and_Last_page_navigation_arrows_on_Hospital_page.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster App with valid credentials' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='select country and proceed with office button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on the DigitEYESSetting Module' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the Hospital modules link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_click_on_the_Hospitals_link.ds"' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[4]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;hospitals.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Hospitals&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[3]/div/ul/li[3]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;digiteyes-settings&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[3]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;hospitals.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;digiteyes-settings&apos;]/ul/li[3]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Hospitals&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='click on the next page' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Parent' value='italic(0, _in(link(&quot;pn_2&quot;)))' fallback='true' selected='true'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;fa fa-angle-right&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='italic(0, _in(link({&apos;id&apos;:&apos;pn_2&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='italic(&quot;fa fa-angle-right&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/thead[2]/tr/th[2]/ul[2]/li[4]/a/i&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;pn_2&apos;)/i[@class=&apos;fa fa-angle-right&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='italic({&apos;style&apos;:&apos;margin-top:2px&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#pn_2 &gt; .fa.fa-angle-right&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[class=&quot;pagination-css&quot;] &gt; i[class=&quot;fa fa-angle-right&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//a[@id=&apos;pn_2&apos;]/i&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='verified that the table count show the next page records' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;Showing:  11 - 20 of 23&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='tableHeader(8, _in(table(&quot;datatable&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='tableHeader(8, _in(table({&apos;id&apos;:&apos;datatable&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Showing:  11 - 20 of 23&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/thead[2]/tr/th&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/thead[2]/tr[1]/th[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='tableHeader({&apos;colspan&apos;:&apos;4&apos;})' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/thead[2]/tr/th[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='click on the next page' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Parent' value='italic(0, _in(link(&quot;pn_3&quot;)))' fallback='true' selected='true'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;fa fa-angle-right&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='italic(0, _in(link({&apos;id&apos;:&apos;pn_3&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='italic(&quot;fa fa-angle-right&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/thead[2]/tr/th[2]/ul[2]/li[6]/a/i&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;pn_3&apos;)/i[@class=&apos;fa fa-angle-right&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#pn_3 &gt; .fa.fa-angle-right&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[class=&quot;pagination-css&quot;] &gt; i[class=&quot;fa fa-angle-right&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//a[@id=&apos;pn_3&apos;]/i&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='verified that the table count show the Last page records' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;Showing:  21 - 23 of 23&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='tableHeader(8, _in(table(&quot;datatable&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='tableHeader(8, _in(table({&apos;id&apos;:&apos;datatable&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Showing:  21 - 23 of 23&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/thead[2]/tr/th&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/thead[2]/tr[1]/th[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='tableHeader({&apos;colspan&apos;:&apos;4&apos;})' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/thead[2]/tr/th[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
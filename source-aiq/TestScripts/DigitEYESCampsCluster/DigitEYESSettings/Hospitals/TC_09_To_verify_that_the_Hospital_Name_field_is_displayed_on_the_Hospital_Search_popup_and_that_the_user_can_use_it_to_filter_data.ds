<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_06_To_verify_that_the_user_can_select_Yes_from_is _Active_dropdown_in_the_Hospital_Search_Filter.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>

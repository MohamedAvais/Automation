<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_16_To_verify_that_the_Define_Hospital_page_allows_the_user_to_add_a_new_hospital.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster App with valid credentials' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='select country and proceed with office button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the DigitEYESSetting Module' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the Hospital modules link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_click_on_the_Hospitals_link.ds"' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[4]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;hospitals.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Hospitals&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[3]/div/ul/li[3]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;digiteyes-settings&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[3]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;hospitals.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;digiteyes-settings&apos;]/ul/li[3]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Hospitals&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='click on the edit icon' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrClass' value='italic(&quot;fa fa-pencil&quot;)' fallback='true' selected='true'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;fa fa-pencil&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/table/tbody/tr/td/a/i&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;datatable&apos;)/tbody[1]/tr[1]/td[@class=&apos;px-2&apos;]/a[1]/i[@class=&apos;fa fa-pencil&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='TableXPath' value='byXPath(&apos;//tbody//tr[1]//td[1]//a//i[@class=&quot;fa fa-pencil&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='italic({&apos;aria-hidden&apos;:&apos;true&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.fa.fa-pencil&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;i[class=&quot;fa fa-pencil&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/tbody/tr[1]/td[1]/a/i&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='setValue' value='"Bihar12"' type='web' desc='edit the state field' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='textbox(&quot;state&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrName' value='textbox(&quot;state&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//input[@id=&apos;state&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;state&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='textbox(&quot;form-control[4]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;state&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div/div/div[2]/div/div/div[2]/form/div[4]/div[2]/input&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;state&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#state&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;state&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;ibox-content1&quot;] &gt; form[class=&quot;form-horizontal&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-5&quot;] &gt; input[class=&quot;form-control&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[value=&quot;Bihar&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='click on the Submit button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrName' value='submit(&quot;btnsubmit&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//form[@id=&apos;frmAddData&apos;]/div[7]/div[2]/button[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='submit(&quot;Save&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;btn btn-primary btn-sm&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;btnsubmit&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Save&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div[2]/div/div/div[2]/div/div/div[2]/form/div[7]/div[2]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;frmAddData&apos;)/div[@class=&apos;row pt-3&apos;]/div[@class=&apos;col-sm-7 text-end&apos;]/button[@class=&apos;btn btn-sm btn-primary&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#frmAddData &gt; .row.pt-3 &gt; .col-sm-7.text-end &gt; .btn.btn-sm.btn-primary&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;button[name=&quot;btnsubmit&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;ibox-content1&quot;] &gt; form[class=&quot;form-horizontal&quot;] &gt; div[class=&quot;row pt-3&quot;] &gt; div[class=&quot;col-sm-7 text-end&quot;] &gt; button[class=&quot;btn btn-sm btn-primary&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='""' type='web' desc='click on the SF Sync button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='button(&quot;btnSyncFromSF&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnSyncFromSF&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='button(&quot;Sync from SF&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnSyncFromSF&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-info btn-sm[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Sync from SF&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div[2]/form/button[4]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnSyncFromSF&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnSyncFromSF&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='verify that the syncing process is in progress alert appear on right bottom' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='div(&quot;Processing.... Please wait...&quot;)' fallback='true' selected='true'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;toast-message&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='div(5, _in(div(&quot;toast-container&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='div(5, _in(div({&apos;id&apos;:&apos;toast-container&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;toast-message&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Processing.... Please wait...&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[3]/div[2]/div[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;toast-container&apos;)/div[@class=&apos;toast toast-info&apos;]/div[@class=&apos;toast-message&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#toast-container &gt; .toast.toast-info &gt; .toast-message&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;toast-bottom-right&quot;] &gt; div[class=&quot;toast toast-info&quot;] &gt; div[class=&quot;toast-message&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;toast-container&apos;]/div[2]/div[2]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='' type='web' desc='verified that the sync process complete alert appear right above the waiting process' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;toast-bottom-right&quot;]&apos;).xy(0.67, 0.26 )' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;toast-container&apos;]&quot;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;toast-container&quot;]&apos;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='div(&quot;toast-bottom-right&quot;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div[3]&apos;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;toast-container&apos;)&quot;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='Attribute' value='div({&apos;role&apos;:&apos;alert&apos;}).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#toast-container&apos;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;toast-bottom-right&quot;]&apos;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
   <accessor type='Id' value='div(&quot;toast-container&quot;).xy(0.67, 0.26 )' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
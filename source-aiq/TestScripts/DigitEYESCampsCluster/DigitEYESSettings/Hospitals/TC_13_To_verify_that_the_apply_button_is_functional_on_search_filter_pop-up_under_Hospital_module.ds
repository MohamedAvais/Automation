<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_13_To_verify_that_the_apply_button_is_functional_on_search_filter_pop-up_under_Hospital_module.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster App with valid credentials' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='select country and proceed with office button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='click on the DigitEYESSetting Module' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

   <accessor type='Attribute' value='select({&apos;onchange&apos;:&apos;ReloadData(1);&apos;})' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#cmbpagesize&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;select[name=&quot;cmbpagesize&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>

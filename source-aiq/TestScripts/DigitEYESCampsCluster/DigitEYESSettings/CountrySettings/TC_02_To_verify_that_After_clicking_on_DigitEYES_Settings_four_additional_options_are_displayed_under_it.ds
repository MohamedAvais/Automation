<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_02_To_verify_that_After_clicking_on_DigitEYES_Settings_six_additional_options_are_displayed_under_it.ds' description= '' author= 'null' version= ''>
<dpl filename='{ds}/../../../../ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to the camp cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on India Country' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on DigitEYES Settings' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/DigitEYESSettings/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that Implementation partner option is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='link(&quot;Implementation Partners&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrHref' value='link(&quot;implementationpartners.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;digiteyes-settings&apos;]/ul/li[1]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Implementation Partners&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[3]/div/ul/li/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;digiteyes-settings&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[1]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;implementationpartners.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[2]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that Country settings option is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='link(&quot;Country Settings&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrHref' value='link(&quot;countrysettings.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;digiteyes-settings&apos;]/ul/li[2]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Country Settings&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[3]/div/ul/li[2]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;digiteyes-settings&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[2]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;countrysettings.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that Hospital option is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='link(&quot;Hospitals&quot;)' fallback='true' selected='true'/>
   <accessor type='AttrHref' value='link(&quot;hospitals.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;digiteyes-settings&apos;]/ul/li[3]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Hospitals&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[3]/div/ul/li[3]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;digiteyes-settings&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[3]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;hospitals.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[2]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify that DE Salesforce Field Mapping option is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='listItem(&quot;DE Salesforce Field Mapping&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;digiteyes-settings&apos;]/ul/li[4]&quot;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[3]/div/ul/li[4]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;digiteyes-settings&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[4]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
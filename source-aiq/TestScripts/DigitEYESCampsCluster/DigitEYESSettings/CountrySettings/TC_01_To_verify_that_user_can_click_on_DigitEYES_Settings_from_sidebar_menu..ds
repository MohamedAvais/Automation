   <accessor type='Attribute' value='submit({&apos;data-bs-target&apos;:&apos;#digiteyes-settings&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;align-items-center border-0 btn btn-togglex d-inline-flex rounded[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='Text' value='submit(&quot;DigitEYES Settings&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
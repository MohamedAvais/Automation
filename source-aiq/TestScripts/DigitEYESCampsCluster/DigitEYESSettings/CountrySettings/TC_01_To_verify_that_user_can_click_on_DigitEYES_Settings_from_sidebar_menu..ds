</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on the DIgitEYESSetting link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESSettings/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//nav[@id=&apos;sidebarMenu&apos;]/div/ul/li[3]/button&quot;)' fallback='true' selected='false'/>

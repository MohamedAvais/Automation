<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_08_To_verify_that_three_columns_are_displayed_in_the_header_on_the_Internet_Availability_page.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India from country dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on DigitEYES Reporting button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_DigitEYES_Reporting.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='' fallback='false' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Internet vailabillity button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Internet_Availabillity_button.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Internet_Availabillity_link.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify the &apos;Good&apos; Heading Text is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;Good&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='tableHeader(1, _in(div(&quot;Source_data&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='tableHeader(1, _in(div({&apos;id&apos;:&apos;Source_data&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='tableHeader(&quot;text-center&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;Source_data&apos;]/div/div/table/thead/tr[2]/th[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Good&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div[2]/div/div/div/div/div/div/table/thead/tr[2]/th&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;Source_data&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-12 ps-4&apos;]/table[@class=&apos;table&apos;]/thead[1]/tr[2]/th[@class=&apos;text-center&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;th[class=&quot;text-center&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify the &apos;Unreliable&apos; Heading Text is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;Unreliable&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='tableHeader(2, _in(div(&quot;Source_data&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='tableHeader(2, _in(div({&apos;id&apos;:&apos;Source_data&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='tableHeader(&quot;text-center[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;Source_data&apos;]/div/div/table/thead/tr[2]/th[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Unreliable&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div[2]/div/div/div/div/div/div/table/thead/tr[2]/th[2]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify the &apos;No&apos; Heading Text is present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;No&quot;)' fallback='true' selected='true'/>
   <accessor type='Parent' value='tableHeader(3, _in(div(&quot;Source_data&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='tableHeader(3, _in(div({&apos;id&apos;:&apos;Source_data&apos;})))' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='tableHeader(&quot;text-center[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;Source_data&apos;]/div/div/table/thead/tr[2]/th[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;No&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div[2]/div/div/div/div/div/div/table/thead/tr[2]/th[3]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
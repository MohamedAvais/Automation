<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_03_To_verify_that_user_can_select_WorK_Report-VS_Teams_under_DigitEYES_Reporting_button.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India from country dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on DigitEYES Reporting button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_DigitEYES_Reporting.ds"' fallback='true' selected='true'/>
   <accessor type='Attribute' value='submit({&apos;data-bs-target&apos;:&apos;#dereport-collapse&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;align-items-center border-0 btn btn-togglex d-inline-flex rounded[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//nav[@id=&apos;sidebarMenu&apos;]/div/ul/li[4]/button&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; DigitEYES Reporting&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[4]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='Text' value='submit(&quot;DigitEYES Reporting&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Work Reprot-VS Teams link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Work_report_VS_teams.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify Work Report - VS Teams heading is visible.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='heading3(&quot;Work Report - VS Teams&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&apos;//header/div[1]/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;m-0&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Work Report - VS Teams&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div/h3&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;/html[1]/body[1]/header[@class=&apos;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&apos;]/div[@class=&apos;col-md-3 col-lg-3 ps-1&apos;]/h3[@class=&apos;m-0&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;header[class=&quot;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&quot;] &gt; div[class=&quot;col-md-3 col-lg-3 ps-1&quot;] &gt; h3[class=&quot;m-0&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;.navbar.navbar-dark.sticky-top.flex-md-nowrap.shadow.p-0.bg-primary &gt; .col-md-3.col-lg-3.ps-1 &gt; .m-0&apos;)' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='heading3(&quot;m-0&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
</dialect>
</step>
<step action='click' value='""' type='web' desc='Click on Export button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='button(&quot;Export&quot;)' fallback='true' selected='true'/>
   <accessor type='Attribute' value='button({&apos;onclick&apos;:&quot;javascript:window.location.assign(&apos;report-export.php&apos;);&quot;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-info btn-sm[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&apos;//header/div[2]/form/button[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Export&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div[2]/form/button[3]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
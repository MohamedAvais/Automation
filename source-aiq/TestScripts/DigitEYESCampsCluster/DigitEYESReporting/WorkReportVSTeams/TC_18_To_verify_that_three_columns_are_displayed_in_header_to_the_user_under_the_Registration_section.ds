<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_17_To_verify_the_presence_of_six_columns_in_header_section_on_the_Work_Report_VS_Teams_page.ds' description= '' author= 'null' version= ''>
<dpl filename='REPOSITORY/VisionSpring/DigitEYES-VisionSpring/ResourcesNew/JS_DPL_Camp_Cluster.csv' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Navigate to URL' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India from country dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on DigitEYES Reporting link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_DigitEYES_Reporting.ds"' fallback='true' selected='true'/>
   <accessor type='Attribute' value='submit({&apos;data-bs-target&apos;:&apos;#dereport-collapse&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;align-items-center border-0 btn btn-togglex d-inline-flex rounded[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//nav[@id=&apos;sidebarMenu&apos;]/div/ul/li[4]/button&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; DigitEYES Reporting&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[4]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='Text' value='submit(&quot;DigitEYES Reporting&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on Work Report - VS Teams link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Work_report_VS_teams.ds"' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;report.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;dereport-collapse&apos;]/ul/li[2]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Work Report - VS Teams&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[4]/div/ul/li[2]/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;dereport-collapse&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[2]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;report.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Work Report - VS Teams&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify #Participant is visible in header section' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;#Participant&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/thead/tr[2]/th[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;#Participant&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/div/div[2]/table/thead/tr[2]/th[3]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;Source_data&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-5&apos;]/table[@id=&apos;datatable&apos;]/thead[1]/tr[2]/th[3]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify &quot;Email ID is visible in header section' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;Email ID&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/thead/tr[2]/th[1]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Email ID&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/div/div[2]/table/thead/tr[2]/th&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;Source_data&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-5&apos;]/table[@id=&apos;datatable&apos;]/thead[1]/tr[2]/th[1]&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verify #Camps is visible in header section' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Text' value='tableHeader(&quot;#Camps&quot;)' fallback='true' selected='true'/>
   <accessor type='XPath' value='byXPath(&quot;//table[@id=&apos;datatable&apos;]/thead/tr[2]/th[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;#Camps&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div/div/div/div/div/div/div/div/div[2]/table/thead/tr[2]/th[2]&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;Source_data&apos;)/div[@class=&apos;row&apos;]/div[@class=&apos;col-sm-5&apos;]/table[@id=&apos;datatable&apos;]/thead[1]/tr[2]/th[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='tableHeader({&apos;style&apos;:&apos;text-align:center;&apos;})' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
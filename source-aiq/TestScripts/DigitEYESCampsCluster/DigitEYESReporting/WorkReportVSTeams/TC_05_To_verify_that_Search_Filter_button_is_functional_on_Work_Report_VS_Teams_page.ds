<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_05_To_verify_that_Search_Filter_button_is_functional_on_Work_Report_VS_Teams_page.ds' description= '' author= 'null' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Navigate to URL' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India from country dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on DigitEYES Reporting link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_DigitEYES_Reporting.ds"' fallback='true' selected='true'/>
   <accessor type='Attribute' value='submit({&apos;data-bs-target&apos;:&apos;#dereport-collapse&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='submit(&quot;align-items-center border-0 btn btn-togglex d-inline-flex rounded[3]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//nav[@id=&apos;sidebarMenu&apos;]/div/ul/li[4]/button&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; DigitEYES Reporting&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[4]/button&apos;)' fallback='true' selected='false'/>
   <accessor type='Text' value='submit(&quot;DigitEYES Reporting&quot;)' fallback='true' selected='false'/>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_DigitEYES_Settings.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Work Reprot- VS Teams link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Work_report_VS_teams.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on Search/Filter button.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Search_filter_button.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='assertExists' value='""' type='web' desc='Verified that the Report Search/Filter are present' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='Id' value='heading4(&quot;myModalLabel&quot;)' fallback='true' selected='true'/>
   <accessor type='Text' value='heading4(&quot;Report Search / Filter&quot;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading4(0, _in(div(&quot;Modal_frmSearch&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='heading4(0, _in(div({&apos;id&apos;:&apos;Modal_frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;myModalLabel&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='heading4({&apos;align&apos;:&apos;left&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='heading4(&quot;modal-title&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//h4[@id=&apos;myModalLabel&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;modal-title&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Report Search / Filter&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div/h4&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;myModalLabel&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#myModalLabel&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;modal fade show&quot;] &gt; div[class=&quot;modal-dialog&quot;] &gt; div[class=&quot;modal-content&quot;] &gt; div[class=&quot;modal-header&quot;] &gt; h4[class=&quot;modal-title&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
</testcase>
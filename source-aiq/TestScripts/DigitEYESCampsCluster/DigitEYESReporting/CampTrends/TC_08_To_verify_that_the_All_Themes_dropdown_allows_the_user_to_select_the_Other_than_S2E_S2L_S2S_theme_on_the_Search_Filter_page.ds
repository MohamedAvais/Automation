<step action='assertExists' value='' type='web' desc='Verify country display in dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='select(&quot;id==search_countrycode&quot;)' fallback='true' selected='true'/>
</dialect>
</step>
<step action='setSelected' value='&quot;Other than S2E, S2L, S2S&quot;' type='web' desc='Select Other than S2E, S2L, S2S from dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>

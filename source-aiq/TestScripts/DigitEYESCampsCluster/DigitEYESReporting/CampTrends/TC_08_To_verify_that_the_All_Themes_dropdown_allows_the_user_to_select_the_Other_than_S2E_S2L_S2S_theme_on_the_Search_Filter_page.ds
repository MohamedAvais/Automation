   <accessor type='JQuery' value='byJQuery(&apos;select[name=&quot;search_theme&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#search_theme&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on Apply button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>

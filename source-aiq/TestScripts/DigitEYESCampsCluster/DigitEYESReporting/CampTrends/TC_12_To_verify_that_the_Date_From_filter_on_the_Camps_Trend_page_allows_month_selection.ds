<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_12_To_verify_that_the_Date_From_filter_on_the_Camps_Trend_page_allows_month_selection.ds' description= '' author= 'null' version= ''>
<dpl filename='' exectype='runstepbystep' errorhandling='' type='JsDPL' locale='null'/>
<fallback useFallback='true'/>
<shadowDOM useShadowDOM='true'/>
<step action='include' value='' type='web' desc='Login to Camp Cluster ' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Login_To_Camp_Cluster.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Select India from country dropdown' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='true'/>
   <accessor type='unknown' value='"REPOSITORY/VisionSpring/DigitEYES-VisionSpring/UtilityFunctions/LoginToTheCampCluster/UF_Click_on_India_Country.ds"' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='' type='web' desc='Click on DigitEYES Reporting link' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_DigitEYES_Reporting.ds"' fallback='true' selected='true'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on Camp Trends button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Camp_Trends_button.ds"' fallback='true' selected='true'/>
   <accessor type='AttrClass' value='link(&quot;d-inline-flex link-dark rounded text-decoration-none[2]&quot;)' fallback='true' selected='false'/>
   <accessor type='AttrHref' value='link(&quot;camptrends.php&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//div[@id=&apos;dereport-collapse&apos;]/ul/li[1]/a&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot;Camp Trends&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/nav/div/ul/li[4]/div/ul/li/a&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;dereport-collapse&apos;)/ul[@class=&apos;btn-toggle-nav list-unstyled fw-normal pb-1 small&apos;]/li[1]/a[@class=&apos;link-dark d-inline-flex text-decoration-none rounded&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;a[href=&quot;camptrends.php&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Text' value='link(&quot;Camp Trends&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='include' value='""' type='web' desc='Click on Search/Filter button' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='unknown' value='"{ds}/../../../../UtilityFunctions/DigitEYESReporting/UF_Click_on_Search_filter_button.ds"' fallback='true' selected='true'/>
   <accessor type='Text' value='button(&quot;Search / Filter&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnSearch&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='button({&apos;type&apos;:&apos;button&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='button(&quot;btn btn-info btn-sm&quot;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//button[@id=&apos;btnSearch&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;btn btn-sm btn-info&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPathText' value='byXPath(&apos;//*[text()=&quot; Search / Filter&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/header/div[2]/form/button&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;btnSearch&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#btnSearch&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;header[class=&quot;navbar navbar-dark sticky-top flex-md-nowrap shadow p-0 bg-primary&quot;] &gt; div[class=&quot;col-md-5 col-lg-5 text-center&quot;] &gt; form[class=&quot;form-inline&quot;] &gt; button[class=&quot;btn btn-sm btn-info&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Id' value='button(&quot;btnSearch&quot;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='click' value='&quot;March 2026&quot;' type='web' desc='Click on Date From filter and select month.' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrName' value='monthbox(&quot;search_datefrom&quot;)' fallback='true' selected='true'/>
   <accessor type='Id' value='monthbox(&quot;search_datefrom&quot;)' fallback='true' selected='false'/>
   <accessor type='Parent' value='monthbox(0, _in(form(&quot;frmSearch&quot;)))' fallback='true' selected='false'/>
   <accessor type='Parent' value='monthbox(0, _in(form({&apos;id&apos;:&apos;frmSearch&apos;})))' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;search_datefrom&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='Attribute' value='monthbox({&apos;type&apos;:&apos;month&apos;})' fallback='true' selected='false'/>
   <accessor type='AttrClass' value='monthbox(&quot;form-control&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathName' value='byXPath(&apos;//*[@name=&quot;search_datefrom&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='XPath' value='byXPath(&quot;//input[@id=&apos;search_datefrom&apos;]&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathClass' value='byXPath(&apos;//*[@class=&quot;form-control&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='AbsoluteXPath' value='byXPath(&apos;/html/body/div/div/main/div/div[2]/div/div/div[2]/form/div/div[2]/div/div/input&apos;)' fallback='true' selected='false'/>
   <accessor type='RelativeXPath' value='byXPath(&quot;id(&apos;search_datefrom&apos;)&quot;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;input[name=&quot;search_datefrom&quot;]&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;#search_datefrom&apos;)' fallback='true' selected='false'/>
   <accessor type='JQuery' value='byJQuery(&apos;div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-6&quot;] &gt; div[class=&quot;row&quot;] &gt; div[class=&quot;col-sm-7&quot;] &gt; input[class=&quot;form-control&quot;]&apos;)' fallback='true' selected='false'/>
</dialect>
</step>
<step action='assertContainsText' value='""' type='web' desc='Verified the date from fiter should select current month' isThinkTime='false' isCommented='false' isMasked='false' isHidden='false' sequence='0'>
  <dialect type='sahi'>
   <accessor type='AttrName' value='monthbox(&quot;search_datefrom&quot;)' fallback='true' selected='true'/>

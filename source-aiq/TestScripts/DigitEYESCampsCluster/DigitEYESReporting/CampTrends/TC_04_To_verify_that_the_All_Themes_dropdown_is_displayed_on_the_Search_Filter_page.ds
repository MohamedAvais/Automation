   <accessor type='Text' value='button(&quot;Search / Filter&quot;)' fallback='true' selected='false'/>
   <accessor type='XPathId' value='byXPath(&apos;//*[@id=&quot;btnSearch&quot;]&apos;)' fallback='true' selected='false'/>

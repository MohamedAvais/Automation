<?xml version='1.0' encoding='UTF-8'?>
<testcase   name= 'TC_66_To_verify_that_the_country_selected_by_the_user_on_the_Countries_page_is_correctly_reflected_in_the_Country_dropdown_on_the_Camp_Trends.ds' description= '' author= 'null' version= ''>
